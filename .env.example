# Azure Cosmos DB Configuration
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-primary-or-secondary-key
COSMOS_ACCOUNT_NAME=your-account-name
COSMOS_DATABASE=ProductCatalog

# Optional: Multi-region configuration
COSMOS_PREFERRED_REGIONS=East US,West US 2

# Optional: Connection settings
COSMOS_CONNECTION_TIMEOUT=30000
COSMOS_REQUEST_TIMEOUT=60000
COSMOS_MAX_RETRY_ATTEMPTS=9
COSMOS_MAX_RETRY_WAIT_TIME=30
